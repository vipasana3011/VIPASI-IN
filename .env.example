# ========================================================
# VIPASI ATELIER — ENVIRONMENT VARIABLES (.env.example)
# ========================================================
# NOTE: The VIPASI website is fully self-contained and ready to
# deploy on Vercel immediately without mandatory environment variables!
# The catalog, cart, wishlist, and customer account portal use
# statically bundled assets and local storage persistence.
#
# If you wish to connect external live services later (e.g. Razorpay,
# Resend Email), you can optionally add the following variables in Vercel:
# ========================================================

# 1. Site Domain URL (Optional)
# Used for canonical SEO links and metadata
NEXT_PUBLIC_SITE_URL=https://vipasi.in

# 2. Atelier Contact & Email (Optional)
# Destination email address for customer concierge inquiries
CONTACT_RECEIVER_EMAIL=admin@vipasi.in

# 3. Resend / Transactional Email (Optional - for future automated email dispatch)
# Get your key at https://resend.com
# RESEND_API_KEY=re_your_api_key_here

# 4. Razorpay Payment Gateway (Optional - for future live online payments)
# Get your keys at https://dashboard.razorpay.com
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_secret_key_here

# 5. Google Analytics / Meta Pixel (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
